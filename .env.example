# Frontend (public)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Edge Functions (server-side secrets only)
PUBLIC_APP_ORIGIN=https://topbid.example
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Ranking
MIN_BID_USD=1
MAX_BID_USD=999999
TOP_RANK_INCREMENT_USD=5

# NOWPayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=btc

# Binance Pay
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=

# Coinbase Commerce / BVNK / Bybit Pay / PayGo
# These providers are intentionally fail-closed until the merchant API contract,
# credentials and webhook verification scheme are configured.
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
BVNK_API_KEY=
BVNK_WEBHOOK_SECRET=
BYBIT_PAY_API_KEY=
BYBIT_PAY_SECRET=
PAYGO_API_KEY=
PAYGO_WEBHOOK_SECRET=
PAYGO_API_BASE_URL=

# PayGo checkout URL template; provider must support server-created order identifiers/amounts.
# Example template: https://merchant.example/checkout?order={order_id}&amount={amount}
PAYGO_CHECKOUT_URL=
