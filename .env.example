# Frontend (public)
# Netlify production build uses the real values configured in Netlify Environment Variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backward-compatible legacy name (optional during migration)
VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Supabase Edge Functions (server-side secrets only)
PUBLIC_APP_ORIGIN=https://topbid.club
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Ranking
MIN_BID_USD=1
MAX_BID_USD=999999
TOP_RANK_INCREMENT_USD=1
